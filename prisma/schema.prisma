generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  GURU
  SISWA
}

enum AuthMethod {
  EMAIL_PASSWORD
  NISN
}

enum AnswerOption {
  A
  B
  C
  D
}

enum TryoutStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum LearningAspect {
  MATERI
  PENYAMPAIAN
  SOAL
  UMUM
}

enum SentimentLabel {
  POSITIF
  NEGATIF
}

enum LabelSource {
  AUTO
  MANUAL
}

enum AutoMethod {
  LEXICON
  NAIVE_BAYES
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String?         @unique
  avatarUrl      String?
  passwordHash   String?
  role           Role
  authMethod     AuthMethod
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  reviewedSentiments SentimentAnalysis[] @relation("SentimentReviewedByUser")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([role])
  @@index([authMethod])
}

model TeacherProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  nip              String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectTeachers  SubjectTeacher[]
  createdQuestions Question[]
  createdBankSoals BankSoal[]       @relation("TeacherCreatedBankSoals")
  createdTryouts   Tryout[]         @relation("TeacherCreatedTryouts")
  feedbacks        Feedback[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model StudentProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  nisn           String          @unique
  className      String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tryoutSessions TryoutSession[]
  feedbacks      Feedback[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([className])
}

model Subject {
  id              String          @id @default(cuid())
  name            String          @unique
  description     String?         @db.Text
  isActive        Boolean         @default(true)
  questions       Question[]
  bankSoals       BankSoal[]
  tryouts         Tryout[]
  subjectTeachers SubjectTeacher[]
  feedbacks       Feedback[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([isActive])
}

/// Penugasan mengajar: satu baris berarti seorang guru mengampu satu mata
/// pelajaran pada satu kelas. Seorang guru dapat memegang beberapa kelas untuk
/// mata pelajaran yang sama, dan satu mata pelajaran dapat diampu guru berbeda
/// di kelas yang berbeda.
model SubjectTeacher {
  id        String         @id @default(cuid())
  subjectId String
  teacherId String
  className String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  /// Satu kelas hanya boleh punya satu guru untuk tiap mata pelajaran, supaya
  /// penentuan guru yang dinilai pada umpan balik tidak pernah ambigu.
  @@unique([subjectId, className])
  @@index([teacherId])
  @@index([className])
  @@index([subjectId, teacherId])
}

model Question {
  id                 String         @id @default(cuid())
  subjectId          String
  createdByTeacherId String
  questionText       String         @db.Text
  optionA            String         @db.Text
  optionB            String         @db.Text
  optionC            String         @db.Text
  optionD            String         @db.Text
  correctOption      AnswerOption
  explanation        String?        @db.Text
  isActive           Boolean        @default(true)
  subject            Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdByTeacher   TeacherProfile @relation(fields: [createdByTeacherId], references: [id], onDelete: Restrict)
  bankSoalQuestions  BankSoalQuestion[]
  tryoutQuestions    TryoutQuestion[]
  tryoutAnswers      TryoutAnswer[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([subjectId, isActive])
  @@index([createdByTeacherId])
}

model BankSoal {
  id                 String             @id @default(cuid())
  subjectId          String
  createdByTeacherId String
  title              String
  description        String?            @db.Text
  isActive           Boolean            @default(true)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdByTeacher   TeacherProfile     @relation("TeacherCreatedBankSoals", fields: [createdByTeacherId], references: [id], onDelete: Cascade)
  bankSoalQuestions  BankSoalQuestion[]
  tryouts            Tryout[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([subjectId])
  @@index([createdByTeacherId])
  @@index([isActive])
}

model BankSoalQuestion {
  id          String   @id @default(cuid())
  bankSoalId  String
  questionId  String
  orderNumber Int
  bankSoal    BankSoal @relation(fields: [bankSoalId], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([bankSoalId, questionId])
  @@unique([bankSoalId, orderNumber])
  @@index([questionId])
}

model Tryout {
  id                 String          @id @default(cuid())
  subjectId          String
  bankSoalId         String?
  createdByTeacherId String?
  title              String
  description        String?         @db.Text
  isPublished        Boolean         @default(false)
  durationMinutes    Int?
  subject            Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  bankSoal           BankSoal?       @relation(fields: [bankSoalId], references: [id], onDelete: SetNull)
  createdByTeacher   TeacherProfile? @relation("TeacherCreatedTryouts", fields: [createdByTeacherId], references: [id], onDelete: SetNull)
  tryoutQuestions    TryoutQuestion[]
  sessions           TryoutSession[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([subjectId])
  @@index([bankSoalId])
  @@index([createdByTeacherId])
  @@index([isPublished])
  @@index([subjectId, isPublished])
}

model TryoutQuestion {
  id          String   @id @default(cuid())
  tryoutId    String
  questionId  String
  orderNumber Int
  tryout      Tryout   @relation(fields: [tryoutId], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([tryoutId, questionId])
  @@unique([tryoutId, orderNumber])
  @@index([questionId])
}

model TryoutSession {
  id             String          @id @default(cuid())
  studentId      String
  tryoutId       String
  status         TryoutStatus    @default(IN_PROGRESS)
  startedAt      DateTime        @default(now())
  submittedAt    DateTime?
  score          Decimal?        @db.Decimal(5, 2)
  totalQuestions Int             @default(0)
  correctAnswers Int             @default(0)
  student        StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tryout         Tryout          @relation(fields: [tryoutId], references: [id], onDelete: Cascade)
  answers        TryoutAnswer[]
  feedbacks      Feedback[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([studentId])
  @@index([tryoutId])
  @@index([status])
  @@index([studentId, tryoutId])
}

model TryoutAnswer {
  id              String         @id @default(cuid())
  tryoutSessionId String
  questionId      String
  selectedOption  AnswerOption
  isCorrect       Boolean
  answeredAt      DateTime       @default(now())
  tryoutSession   TryoutSession  @relation(fields: [tryoutSessionId], references: [id], onDelete: Cascade)
  question        Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([tryoutSessionId, questionId])
  @@index([questionId])
}

model Feedback {
  id              String            @id @default(cuid())
  studentId       String
  subjectId       String
  teacherId       String?
  tryoutSessionId String
  aspect          LearningAspect
  comment         String            @db.Text
  student         StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         TeacherProfile?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  tryoutSession   TryoutSession     @relation(fields: [tryoutSessionId], references: [id], onDelete: Cascade)
  sentiment       SentimentAnalysis?
  ratings         FeedbackRating[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([tryoutSessionId, aspect])
  @@index([studentId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([aspect])
}

model FeedbackRating {
  id         String   @id @default(cuid())
  feedbackId String
  itemNumber Int
  score      Int
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([feedbackId, itemNumber])
  @@index([feedbackId])
}

model SentimentAnalysis {
  id               String         @id @default(cuid())
  feedbackId       String         @unique
  autoLabel        SentimentLabel
  autoConfidence   Decimal?       @db.Decimal(5, 4)
  autoMethod       AutoMethod
  manualLabel      SentimentLabel?
  finalLabel       SentimentLabel
  labelSource      LabelSource
  preprocessedText String?        @db.Text
  modelVersion     String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?        @db.Text
  feedback         Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  reviewedByUser   User?          @relation("SentimentReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  analyzedAt       DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([autoLabel])
  @@index([finalLabel])
  @@index([labelSource])
  @@index([autoMethod])
  @@index([reviewedByUserId])
}
